# Configuração do Banco de Dados PostgreSQL
# No Docker Compose local: postgresql://postgres:postgres_sou_password@db:5432/sou_uast_db?schema=public
# Para rodar direto no host: postgresql://postgres:postgres_sou_password@localhost:5432/sou_uast_db?schema=public
DATABASE_URL="postgresql://postgres:postgres_sou_password@localhost:5432/sou_uast_db?schema=public"

# Autenticação NextAuth (Auth.js)
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
PUBLIC_BASE_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
FORCE_HTTPS="false"
NEXTAUTH_SECRET="c8d9e2b145a9f248e3e4827d9284cf651873ea7b32810f2d9526efc689437190"

# Armazenamento persistente de uploads
UPLOAD_DIR="./uploads"

# Credenciais iniciais do Administrador geradas pelo seed
ADMIN_INITIAL_NAME="Administrador SOU+UAST"
ADMIN_INITIAL_EMAIL="admin@ufrpe.br"
ADMIN_INITIAL_PASSWORD="Admin@SouUast2025"

# Editor inicial para testes de publicação estilo Drupal
EDITOR_INITIAL_NAME="Editor de Conteúdo UAST"
EDITOR_INITIAL_EMAIL="editor@ufrpe.br"
EDITOR_INITIAL_PASSWORD="Editor@SouUast2025"

# Limite máximo de upload em MB
MAX_UPLOAD_SIZE_MB=15
